{
  "name": "onboardflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "pwsh -NoProfile -File scripts/local.ps1 setup",
    "dev": "vite",
    "api": "pwsh -NoProfile -File scripts/local.ps1 api",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "verify": "pwsh -NoProfile -File scripts/local.ps1 verify",
    "test:browser": "playwright test",
    "stop:db": "pwsh -NoProfile -File scripts/local.ps1 stop-db",
    "format:check": "prettier --check src/web tests/browser vite.config.ts playwright.config.ts package.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "@playwright/test": "^1.58.0"
  }
}
