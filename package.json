{
  "name": "onboardflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "pwsh -NoProfile -File scripts/local.ps1 setup",
    "dev": "vite",
    "api": "pwsh -NoProfile -File scripts/local.ps1 api",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p preview/content-snare/tsconfig.json --noEmit",
    "verify": "pwsh -NoProfile -File scripts/local.ps1 verify",
    "test:browser": "playwright test",
    "test:edge": "node --test edge/worker.test.mjs",
    "stop:db": "pwsh -NoProfile -File scripts/local.ps1 stop-db",
    "format:check": "prettier --check preview/content-snare/src preview/content-snare/index.html preview/content-snare/vite.config.ts preview/content-snare/playwright.config.ts preview/content-snare/tests scripts/*.mjs edge/*.js edge/*.mjs edge/*.jsonc .github/workflows vite.config.ts playwright.config.ts package.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/open-sans": "5.3.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
